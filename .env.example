NODE_ENV=development
DATABASE_URL=postgresql://actionow:actionow@localhost:5433/actionow
REDIS_URL=redis://localhost:6380
API_PORT=3000
LOG_LEVEL=info

# Object storage (S3-compatible). For local dev the compose `minio` service is
# exposed on 9100 (host 9000 may be taken by another local stack).
STORAGE_PROVIDER=minio
STORAGE_BUCKET=actionow
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9100
STORAGE_ACCESS_KEY_ID=actionow
STORAGE_SECRET_ACCESS_KEY=actionow123
STORAGE_FORCE_PATH_STYLE=true
MINIO_ENDPOINT=http://localhost:9100
MINIO_ROOT_USER=actionow
MINIO_ROOT_PASSWORD=actionow123
