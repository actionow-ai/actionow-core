VITE_API_BASE_URL=
VITE_OAUTH_ENABLED=false
# White-label: the brand wordmark shown in the logo / footer / page title.
VITE_BRAND_NAME=Actionow
# Deployment mode: `marketing` (default) serves the Landing page at `/`;
# `app` is a white-label SaaS with no marketing site, so `/` redirects straight
# to the console/login.
VITE_DEPLOYMENT_MODE=marketing
