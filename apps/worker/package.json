{
  "name": "@actionow/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@actionow/adapters": "workspace:*",
    "@actionow/contracts": "workspace:*",
    "@actionow/db": "workspace:*",
    "@actionow/domain": "workspace:*",
    "@actionow/engine": "workspace:*",
    "@actionow/infra": "workspace:*",
    "@actionow/spi": "workspace:*",
    "bullmq": "^5.13.0",
    "ioredis": "^5.10.1",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
