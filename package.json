{
  "name": "actionow-core",
  "version": "0.0.13",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter @actionow/api exec vitest run test/full-stack.e2e.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md,yaml}\"",
    "check:tokens": "node tools/check-design-tokens.mjs",
    "db:generate": "pnpm --filter @actionow/db db:generate",
    "db:migrate": "pnpm --filter @actionow/db db:migrate",
    "dev:api": "pnpm --filter @actionow/api start:dev",
    "dev:worker": "pnpm --filter @actionow/worker start:dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prepare": "husky && (git config --local commit.template .gitmessage || true)"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    }
  }
}
