# syntax=docker/dockerfile:1
#
# Zeabur `web` service image: build the whole monorepo (the SPA depends on
# workspace packages), then serve the pre-built Vite SPA via nginx, which
# reverse-proxies the API on the SAME ORIGIN (see docker/nginx.conf — its
# upstream `api:3000` resolves over Zeabur private networking when the API
# service is named `api`). Selected per-service via `ZBPACK_DOCKERFILE_NAME`.

# ---- build: install + build the whole monorepo ----
FROM node:22-slim AS build
WORKDIR /app
ENV HUSKY=0 CI=true
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build

# ---- serve the SPA via nginx ----
FROM nginx:1.27-alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
