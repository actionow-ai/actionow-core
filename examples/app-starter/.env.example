ACTIONOW_BASE_URL=https://core.actionow.ai
# Console creds MUST be a TENANT ADMIN (create-subject / mint-key / redeem require
# tenant_role=admin, else HTTP 403). A self-registered console user is admin by default.
ACTIONOW_CONSOLE_EMAIL=admin@yourapp.example
ACTIONOW_CONSOLE_PASSWORD=
# The proxy's data-plane key: a TENANT-LEVEL ak_ (no subjectId) so per-call
# end_user=<external_id> attributes spend correctly. A subject-scoped key can only
# ever serve its one bound end-user (mismatched end_user -> 401).
ACTIONOW_PROXY_API_KEY=ak_...
ACTIONOW_WEBHOOK_SECRET=
# Public https origin core can reach (for media webhook mode's callback_url).
# Leave empty to use polling instead. Local dev: a tunnel URL (ngrok, …).
PUBLIC_BASE_URL=
ACTIONOW_MODEL=gpt-4o
PORT=8787
